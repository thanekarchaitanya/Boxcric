# Gemini API Key (if using Gemini features)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web SDK Configuration
# Get these values from Firebase Console > Project Settings > Your apps
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=boxcriclive.firebaseapp.com
FIREBASE_PROJECT_ID=boxcriclive
FIREBASE_STORAGE_BUCKET=boxcriclive.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# NOTE: The private key from the service account should NEVER be exposed in the frontend
# It should only be used on a backend server for admin operations
